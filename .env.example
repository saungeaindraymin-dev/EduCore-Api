DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=a-random-string-of-at-least-32-characters
JWT_EXPIRES=7d
CORS_ORIGIN=http://localhost:3000

# --- Mail -------------------------------------------------------------------
# MAIL_TRANSPORT: auto (default) | smtp | log | ethereal
#   auto      SMTP when the credentials below are filled in, otherwise log.
#   log       nothing is emailed: the code is printed in the API log, a copy of
#             the mail is saved to .mail/, and the reset screens fill the code in
#             for you. Development only — production refuses to start in this mode.
#   ethereal  a throwaway inbox; the log prints a preview URL. No account needed.
# Resend: SMTP_USER is literally "resend" and SMTP_PASS is an API key (re_...).
# Until a domain is verified there, MAIL_FROM must be "EduCore <onboarding@resend.dev>"
# and it will only deliver to the address that owns the Resend account.
MAIL_TRANSPORT=auto
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="EduCore <noreply@educore.app>"

PORT=4000
NODE_ENV=development
